{
  "name": "todo-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "*",
    "chrono-node": "*",
    "expo": "~52.0.0",
    "expo-constants": "*",
    "expo-file-system": "*",
    "expo-font": "*",
    "expo-haptics": "*",
    "expo-linking": "*",
    "expo-router": "*",
    "expo-status-bar": "*",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
    "react-native-screens": "*"
  },
  "devDependencies": {
    "@babel/core": "*",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-typescript": "^7.28.5",
    "@types/react": "*",
    "babel-jest": "^30.4.1",
    "babel-plugin-module-resolver": "*",
    "jest": "*",
    "jest-expo": "*",
    "typescript": "*"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": [
        "babel-jest"
      ]
    },
    "moduleNameMapper": {
      "^@shared/(.*)$": "<rootDir>/../shared/$1"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ]
  }
}
